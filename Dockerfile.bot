# ==============================================================================
# NexNum Telegram Bot Dockerfile (Monorepo Root)
# ==============================================================================

FROM python:3.11-slim

WORKDIR /app

# Prevent Python from writing .pyc files and buffer stdout/stderr
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

# Install system build dependencies and wait-for-it helper
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        gcc \
        g++ \
        make \
        libssl-dev \
        libffi-dev \
        python3-dev \
    && curl -fsSL https://raw.githubusercontent.com/vishnubob/wait-for-it/master/wait-for-it.sh -o /usr/local/bin/wait-for-it.sh \
    && chmod +x /usr/local/bin/wait-for-it.sh \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements from nexnum-bot directory
COPY nexnum-bot/requirements.txt /app/requirements.txt

# Upgrade pip and install all Python dependencies from requirements.txt
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r /app/requirements.txt

# Copy complete bot application code
COPY nexnum-bot /app

# Wait for Redis, then start the bot in production polling mode
ENTRYPOINT ["/usr/local/bin/wait-for-it.sh", "redis:6379", "--"]
CMD ["python", "bot_project/main.py"]
