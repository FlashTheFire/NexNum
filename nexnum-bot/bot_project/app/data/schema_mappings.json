        "sims_array": "sims",
        "sim_item": {
          "slot": ["simSlotIndex", "slot", "subId", "index"],
          "phone_number": ["phoneNumber", "mobNo", "number", "phone"],
          "carrier": ["carrierName", "service_provider", "network", "operator", "carrier"]
        }
      },
      "message_mappings": {
        "id": ["id", "$key"],
        "body": ["message", "messagePreview", "body", "text"],
        "sender": ["sender", "from"],
        "sender_type": ["senderType"],
        "timestamp": ["dateTime", "timestamp", "isoTime", "time"],
        "type": ["type", "direction"],
        "sim_slot": ["simSlotIndex", "simSlot", "slot"],
        "is_otp": ["isOtp"],
        "otp_code": ["otpCode"]
      }
    },
    "legacy_light": {
      "device_path": "/clients",
      "message_path": "/messages/{device_id}",
      "mappings": {
        "device_id": ["deviceId", "id", "clientId", "$key"],
        "phone_number": ["mobNo", "phoneNumber", "number"],
        "carrier": ["service_provider", "network", "operator"],
        "status": ["status"],
        "battery": ["battery"],
        "model": ["modelName", "model"]
      },
      "message_mappings": {
        "id": ["id", "$key"],
        "body": ["message", "messagePreview", "body", "text"],
        "sender": ["sender", "from"],
        "timestamp": ["dateTime", "timestamp", "isoTime"],
        "type": ["type", "direction"]
      }
    },
    "legacy_dual": {
      "device_path": "/clients",
      "message_path": "/messages/{device_id}",
      "mappings": {
        "device_id": ["deviceId", "id", "clientId", "$key"],
        "phone_number": ["mobNo", "phoneNumber", "number"],
