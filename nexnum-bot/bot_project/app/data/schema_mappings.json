{
  "schema_version": "3.0",
  "default_schema": "auto",
  "schemas": {
    "silentgate": {
      "device_path": "/gateways",
      "message_path": "/messages/{device_id}",
      "mappings": {
        "device_id": ["deviceId", "id", "gateway_id", "$key"],
        "phone_number": ["mobNo", "phoneNumber", "phone", "number"],
        "carrier": ["service_provider", "carrier", "operator", "network"],
        "status": ["status", "online"],
        "battery": ["battery"],
        "model": ["modelName", "model"],
        "sims_array": "sims",
        "sim_item": {
          "slot": ["simSlotIndex", "slot", "subId", "index"],
          "phone_number": ["phoneNumber", "mobNo", "number", "phone"],
          "carrier": ["carrierName", "carrier", "service_provider", "operator", "network"]
        }
      },
      "message_mappings": {
        "id": ["id", "$key"],
        "body": ["message", "messagePreview", "body", "text"],
        "sender": ["sender", "from"],
        "sender_type": ["senderType"],
        "timestamp": ["timestamp", "dateTime", "isoTime", "time"],
        "type": ["type", "direction"],
        "sim_slot": ["simSlotIndex", "simSlot", "slot"],
        "is_otp": ["isOtp"],
        "otp_code": ["otpCode"]
      }
    },
    "legacy_rich": {
      "device_path": "/clients",
      "message_path": "/messages/{device_id}",
      "mappings": {
        "device_id": ["deviceId", "id", "clientId", "$key"],
