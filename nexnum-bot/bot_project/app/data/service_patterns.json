{
  "tg": {
    "name": "Telegram",
    "senders": ["(?i)Telegram", "(?i)TGRAM", "(?i)TG-", "5-digit shortcode"],
    "sender_patterns": ["(?i)telegram", "(?i)tgram", "(?i)tg-"],
    "body_patterns": [
      "(?i)telegram",
      "(?i)login code:?\\s*\\d{5}",
      "(?i)code:?\\s*\\d{5}",
      "(?i)do not give this code to anyone",
      "(?i)web login code"
    ],
    "otp_regex": "\\b(\\d{5})\\b"
  },
  "wa": {
    "name": "WhatsApp",
    "senders": ["(?i)WhatsApp", "(?i)WHATSAPP"],
    "sender_patterns": ["(?i)whatsapp"],
    "body_patterns": [
      "(?i)whatsapp",
      "(?i)code:?\\s*\\d{3}-\\d{3}",
      "(?i)verification code",
      "(?i)your whatsapp code"
    ],
    "otp_regex": "\\b(\\d{3}[-\\s]?\\d{3})\\b"
  },
