{
  "tg": {
    "name": "Telegram",
    "senders": ["(?i)Telegram", "(?i)TGRAM", "(?i)TG-", "5-digit shortcode"],
    "sender_patterns": ["(?i)telegram", "(?i)tgram", "(?i)tg-"],
    "body_patterns": [
      "(?i)telegram",
      "(?i)t\\.me/login",
      "(?i)login code",
      "(?i)web login code",
      "(?i)do not give this code to anyone"
    ],
    "otp_regex": "(?:https?://[^\\s/]+|HTTPS?:[^\\s/]+)?/(?:login|verify|auth|v|code)/([A-Za-z0-9]{4,10})\\b|(?i:code|otp|verification|passcode|secret|pin|login|auth|password|key|id|web|\\s)+(?:is|:|-|=)\\s*(?!(?:code|login|otp|verification|is|your|for|this|web|telegram)\\b)([A-Za-z0-9]{4,10})\\b|\\b([A-Za-z0-9]{4,10})\\s+(?:is\\s+your\\s+code|is\\s+your\\s+otp|is\\s+your\\s+verification\\s+code|is\\s+your\\s+login\\s+code)|\\b(\\d{5})\\b"
  },
