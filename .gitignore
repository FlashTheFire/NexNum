# =============================================
# NEXNUM — UNIFIED .gitignore
# =============================================
# This single .gitignore covers both nexnum-app (Next.js) and nexnum-bot (Python/Telegram bot).

# --- Dependencies ---
node_modules/
.pnp/
.pnp.js
.pnp.*
.pdm-python
.python-version

# --- Python (nexnum-bot) ---
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
*.egg-info/
dist/
*.egg

# --- Next.js (nexnum-app) ---
.next/
out/
next-env.d.ts
*.tsbuildinfo

# --- Build Output ---
build/
dist/
*.exe
*.dll
*.so
*.dylib

# --- Debug & Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.eslintcache
.stylelintcache
node_modules_bak/
.node_repl_history

# --- Environment Files ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
! .env.example

# --- IDE & Editor ---
.idea/
.vscode/
.serena/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.history/

# --- OS Specific ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Testing ---
coverage/
.nyc_output
.testsprite
.playwright

# --- Infrastructure Security ---
*.pem
*.key
*.pub

# --- Sentry ---
.sentryclirc

# --- Agent / Cache Artifacts ---
.agent
/cache
project.local.yml

# --- Stitch Design (local-only) ---
/.stitch/
/.stitch/**
nexnum-app/.stitch/
nexnum-app/.stitch/**

# ======== nexnum-bot specific ========

# Bot session files
nexnum-bot/sessions/
nexnum-bot/*.session
nexnum-bot/**/*.session

# Bot user data  
nexnum-bot/user_accounts.json

# Bot images (generated/cached)
nexnum-bot/bot_project/images/current/*.jpg

# Log files
nexnum-bot/application.log
nexnum-bot/support.log
nexnum-bot/bot_project/support.log

# Bot update script
nexnum-bot/fsupdate-safe.sh

# Docker user
nexnum-bot/.dockerignore