# ==============================================================================
# NexNum Unified Git Ignore Specification (.gitignore)
# ==============================================================================

# ── 1. Environment Secrets & Credentials ─────────────────────────────────────
.env
.env*
!.env.example
*.pem
*.key
*.crt
user_accounts.json

# ── 2. Logs & Temporary Debug Files ──────────────────────────────────────────
logs
logs/
*.log
build.log
application.log
support.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── 3. Node.js & Next.js Build Artifacts ──────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
.pnpm-debug.log*
.turbo/
*.tsbuildinfo

# ── 4. Python Environment & Cache ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
.pytest_cache/
.coverage
htmlcov/
.pytype/

# ── 5. Telegram Bot Sessions & User Assets ───────────────────────────────────
*.session
*.session-journal
sessions/
nexnum-bot/*.session
nexnum-bot/**/*.session
nexnum-bot/user_accounts.json
nexnum-bot/bot_project/images/current/*.jpg

# ── 6. OS & IDE System Files ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── 7. Internal Tooling & Worktrees ──────────────────────────────────────────
.stitch/
docs/.stitch/
docs/.stitch/.claude/
.claude/
.antigravity/
.docs/
.serena/