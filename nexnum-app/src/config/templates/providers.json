            },
            "getBalance": {
                "method": "GET",
                "path": "/stubs/handler_api.php",
                "queryParams": {
                    "action": "getBalance"
                }
            },
            "getPrices": {
                "method": "GET",
                "path": "/stubs/handler_api.php",
                "queryParams": {
                    "action": "getPricesV3",
                    "country": "$country",
                    "service": "$service"
                }
