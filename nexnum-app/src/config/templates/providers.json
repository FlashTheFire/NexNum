                    "can_get_another_sms": "boolean"
                }
            },
            "getStatus": {
                "type": "text_regex",
                "regex": "(?<status>STATUS_WAIT_CODE|STATUS_WAIT_RETRY|STATUS_CANCEL|STATUS_OK)(?::(?<code>.+))?",
                "fields": {
                    "status": "status",
                    "code": "code"
                },
                "conditionalFields": {
                    "STATUS_WAIT_CODE": {
                        "status": "PENDING"
                    },
                    "STATUS_WAIT_RETRY": {
                        "status": "PENDING",
                        "message": "Waiting for next sms"
                    },
                    "STATUS_CANCEL": {
                        "status": "CANCELLED"
                    },
                    "STATUS_OK": {
                        "status": "RECEIVED"
                    }
                }
            },
            "setCancel": {
                "type": "text_regex",
                "regex": "ACCESS_CANCEL",
                "fields": {
                    "status": "ACCESS_CANCEL"
                },
                "conditionalFields": {
                    "ACCESS_CANCEL": {
                        "status": "CANCELLED"
                    }
                }
            },
            "getBalance": {
                "type": "text_regex",
                "regex": "ACCESS_BALANCE:(?<balance>[0-9.]+)",
                "fields": {
                    "balance": "balance"
                },
                "transform": {
                    "balance": "number"
                }
            },
            "getPrices": {
                "type": "json_dictionary",
                "nestingLevels": {
                    "extractOperators": true
                },
                "fields": {
                    "cost": "price|cost|rate",
                    "count": "count|qty|stock",
                    "operator": "provider_id|$key",
                    "service": "$parentKey",
                    "country": "$grandParentKey"
                },
                "transform": {
                    "cost": "number",
                    "count": "number"
                }
            }
        }
    },
