        "logo": "/providers/grizzlysms.png",
        "color": "from-amber-500/20 to-orange-500/20",
        "border": "border-amber-500/20 hover:border-amber-500/50",
        "endpoints": {
            "getCountriesList": {
                "method": "GET",
