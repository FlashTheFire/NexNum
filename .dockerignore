# ==============================================================================
# Unified Docker Build Context Exclusions for NexNum & nexnum-bot
# ==============================================================================

# Version control
.git
.gitignore
.github

# Node dependencies & Next.js build outputs
node_modules
.next
out
build
dist
coverage

# Python build & virtual environment exclusions
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
.eggs/
.venv
venv/
env/

# Environment files & secrets
.env*.local
*.key
*.pem

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
sync.log
logs/

# IDE / AI / Tooling
.vscode
.idea
.antigravity
.gemini
.agent
.testsprite
brain

# Redis & Database persistence dumps
data/
dump.rdb
appendonly.aof

# OS artifacts
.DS_Store
Thumbs.db
